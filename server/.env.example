# Puerto donde corre la API
PORT=4000

# Contrasena para el panel de administracion (subir el Excel semanal, ver el tablero completo)
ADMIN_PASSWORD=cambia-esta-clave

# URL del flujo de Power Automate (trigger "Cuando se recibe una solicitud HTTP")
# Se llama cada vez que un tecnico actualiza el estado de una actividad.
# Dejar vacio si todavia no se ha creado el flujo: la app funciona igual, solo no notifica.
POWER_AUTOMATE_WEBHOOK_URL=

# Origen permitido para CORS (URL donde queda publicado el frontend). Usa * solo en pruebas.
CLIENT_ORIGIN=*

# Base de datos en Turso (para que los datos NO se pierdan al reiniciar/redesplegar
# en el plan gratis de Render). Dejar ambas vacias usa un archivo SQLite local
# (se pierde en cada reinicio del servicio si el disco no es persistente).
# Ver docs/TURSO.md para como crear la base y conseguir estos dos valores.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
